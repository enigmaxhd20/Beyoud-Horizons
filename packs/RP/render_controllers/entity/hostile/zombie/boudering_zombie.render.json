{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.bouldering_zombie": {
      "geometry": "query.is_baby ? Geometry.baby : Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.is_baby ? (math.cos(query.life_time * 60.0) > 0.99 ? Texture.baby.blink : Texture.baby.default) : (math.cos(query.life_time * 60.0) > 0.99 ? Texture.blink : Texture.default)"
      ]
    }
  }
}