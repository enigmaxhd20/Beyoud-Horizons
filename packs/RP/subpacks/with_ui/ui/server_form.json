{
  "namespace": "server_form",
  "long_form": {
        "type": "panel",
        "size": [
            "100%",
            "100%"
        ],
        "controls": [
            {
                "long_form@common_dialogs.main_panel_no_buttons": {
                    "$title_panel": "common_dialogs.standard_title_label",
                    "$title_size": [
                        "100% - 15px",
                        10
                    ],
                    "$title_max_size": [
                        "100% - 15px",
                        10
                    ],
                    "size": [
                        225,
                        300
                    ],
                    "$text_name": "#title_text",
                    "$title_text_binding_type": "none",
                    "$child_control": "server_form.long_form_panel",
                    "layer": 2,
                    "bindings": [
                        {
                            "binding_name": "#title_text"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "((#title_text - 'Games' - 'Test') = #title_text)",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "lyy42znamespace@lyy42znamespace.lyy42znamespace": {
                    "layer": 2,
                    "bindings": [
                        {
                            "binding_name": "#title_text"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "( not ((#title_text - 'test') = #title_text))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "7qxtkknamespace@7qxtkknamespace.7qxtkknamespace": {
                    "layer": 2,
                    "bindings": [
                        {
                            "binding_name": "#title_text"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "( not ((#title_text - 'Games') = #title_text))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            }
        ]
    }
}